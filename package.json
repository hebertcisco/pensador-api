{
  "name": "pensador-api",
  "version": "1.0.0",
  "main": "src/server.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "sucrase ./src -d ./dist --transforms typescript,imports",
    "pre-prod": "rimraf dist && sucrase ./src -d ./dist --transforms typescript,imports",
    "dev": "nodemon src/server.ts",
    "format": "npx prettier --write ./**/*.{js,jsx,ts,tsx,md,json}"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^5.1.1",
    "http-status": "^1.8.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.13.8",
    "morgan": "^1.10.1",
    "pensador-promise": "^0.4.6",
    "remark": "14.0.3",
    "remark-html": "15.0.2",
    "rimraf": "^3.0.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.23",
    "@types/helmet": "^0.0.48",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/node": "^18.19.124",
    "@vercel/node": "^2.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.8.8",
    "sucrase": "^3.35.0",
    "typescript": "^4.9.5"
  },
  "description": "Frases do Pensador via WebScraping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebertcisco/pensador-api.git"
  },
  "keywords": [
    "pensador-api",
    "node",
    "mongo",
    "express",
    "javascript",
    "server"
  ],
  "author": "Hebert F. Barros",
  "bugs": {
    "url": "https://github.com/hebertcisco/pensador-api/issues"
  },
  "homepage": "https://github.com/hebertcisco/pensador-api#readme"
}
